// The person's Dropbox: Pipes' `dropbox` provider, connected through the
// browser once its app's secret is in the store (the app Pipes' Dropbox
// integration uses: scoped, Full Dropbox, every scope below ticked on its
// Permissions tab, the platform's callback beside Pipes'; its client id is
// the app's key). `token_access_type=offline` is what has Dropbox answer a
// refresh token, kept until revoked; an access token lasts four hours.
// `scope` asks for a part of the app's scopes, and each route needs its
// own, so a read-only grant cannot write. `openid email` labels the
// account. Its token goes to its API and to its upload and download host; a
// temporary link is on a host of its own and needs none. No `revoke`:
// Dropbox's takes the token as a bearer, not RFC 7009's form, so a
// disconnect deletes the account at Pipes, and the person removes the app
// in Dropbox's connected apps. Its skill is dropbox-finite.
{ "name": "dropbox", "kind": "connection", "title": "Dropbox",
  "hosts": ["api.dropboxapi.com", "content.dropboxapi.com"],
  "placements": [{ "header": "authorization", "format": "Bearer {}" }],
  "key": "<the client secret's store name>",
  "connection_oauth": { "authorize": "https://www.dropbox.com/oauth2/authorize?token_access_type=offline&prompt=consent",
    "exchange": "https://api.dropboxapi.com/oauth2/token",
    "client_id": "<the app's client id>", "access": {
      "read": { "scopes": ["openid", "email", "account_info.read", "files.metadata.read", "files.content.read"] },
      "write": { "scopes": ["openid", "email", "account_info.read", "files.metadata.read", "files.content.read", "files.metadata.write", "files.content.write"] } } },
  "scope_names": { "account_info.read": "Account info", "files.metadata.read": "File details (read)", "files.content.read": "Files (read)",
    "files.metadata.write": "File details", "files.content.write": "Files" },
  "env": ["DROPBOX_OAUTH_ACCESS_TOKEN"] }
