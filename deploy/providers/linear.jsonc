// The person's Linear workspace: Pipes' `linear` provider, connected
// through the browser once its OAuth app's secret is in the store (the app
// Pipes' Linear integration uses, with the platform's callback beside
// Pipes'). Linear grants `read` beside whatever is asked and takes its
// scopes comma-separated, so each access asks for one: `read` read only,
// `write` read and write; `actor=user` acts as the person. Its skill is
// linear-finite.
{ "name": "linear", "kind": "connection", "title": "Linear",
  "hosts": ["api.linear.app", "uploads.linear.app"],
  "placements": [{ "header": "authorization", "format": "Bearer {}" }],
  "key": "<the client secret's store name>",
  "connection_oauth": { "authorize": "https://linear.app/oauth/authorize?actor=user&prompt=consent",
    "exchange": "https://api.linear.app/oauth/token", "revoke": "https://api.linear.app/oauth/revoke",
    "client_id": "<the app's client id>", "access": { "read": { "scopes": ["read"] }, "write": { "scopes": ["write"] } } },
  "scope_names": { "read": "Read issues and projects", "write": "Create and change issues" },
  "env": ["LINEAR_OAUTH_ACCESS_TOKEN"] }
