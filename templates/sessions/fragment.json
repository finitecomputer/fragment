{
  "kind": "sessions",
  "operations": {
    "sessions": {
      "kind": "query",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1, "maxLength": 32 },
          "after": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "filed": {
      "kind": "mutation",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rows": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
          "gone": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 200 } },
          "whole": { "type": "boolean" }
        }
      }
    }
  },
  "meta": {
    "title": "Session Archive",
    "description": "The conversations you had with an agent elsewhere, brought in with fragment session import: a file a conversation, and a row of its list each."
  }
}
