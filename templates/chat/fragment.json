{
  "kind": "chat",
  "channels": {
    "chat": { "read": "public", "post": "viewer" },
    "work": {
      "read": "viewer", "post": "editor", "from": "agent",
      "listed": {
        "kinds": ["turn.start", "turn.step", "turn.prompt", "turn.prompt.closed", "turn.asked", "turn.end"],
        "fields": ["asks", "outcome"]
      }
    }
  },
  "operations": {
    "notify_reply": { "kind": "job" }
  },
  "triggers": [
    { "channel": "chat", "from": "agent", "run": "notify_reply" }
  ],
  "meta": { "title": "Chat", "description": "A chat with your agents: replies stream in, their steps and approvals show as cards, files and voice memos go both ways, and a reply reaches you while you're away." }
}
