#!/usr/bin/env bash
# tools/boat/golden [--force | --fresh]: make or refresh, on your own Boat
# account, the warm snapshot that tools/boat/run starts from
# (FRAGMENT_BOAT_SNAPSHOT, default fragment-warm): current master, cloned
# and built, with its caches.
#
# When the snapshot is already at GitHub's master it does nothing: the
# check reads the snapshot's file list (build-golden.sh leaves
# ~/.boat-keep/warm-at/<commit>) and starts no sandbox, so it is cheap to
# run nightly. Otherwise, or with --force, it starts a builder sandbox from
# the snapshot (from nothing the first time or with --fresh), copies
# tools/boat/sandbox there, runs build-golden.sh, saves the snapshot over
# the old one and deletes the builder. Sandboxes already started from the
# old snapshot keep theirs. About 15 minutes from nothing, 5 to 15 to
# refresh depending on how far master moved. Uses a large sandbox (twice
# the default rate) and one start. Test: tools/boat/test-golden.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/lib.sh"
REMOTE=${FRAGMENT_BOAT_REMOTE:-https://github.com/finitecomputer/fragment}
from=(--from "$SNAPSHOT")
force=0
case "${1:-}" in
  --fresh) from=(); force=1 ;;
  --force) force=1 ;;
  "") ;;
  *) echo "usage: tools/boat/golden [--force | --fresh]" >&2; exit 2 ;;
esac

# The saved snapshot's id, or nothing when there is none yet.
# Boat answers a refused call (an API key without the action, say) on
# stdout: show it rather than end silently.
listing=$("$B" snapshots --limit 1 --json 2>&1) || { echo "tools/boat/golden: boat snapshots failed: $listing" >&2; exit 1; }
snapshot_id=$(printf '%s' "$listing" | python3 -I -c '
import json, sys
ids = [s.get("snapshotId", "") for s in json.load(sys.stdin).get("named", [])
       if s.get("name") == sys.argv[1] and s.get("status") == "ready"]
print(ids[0] if ids else "")
' "$SNAPSHOT")
[ -n "$snapshot_id" ] || { from=(); force=1; }
if [ $force = 0 ]; then
  master=$(git ls-remote "$REMOTE" refs/heads/master | cut -f1)
  [ -n "$master" ] || { echo "tools/boat/golden: no master at $REMOTE" >&2; exit 1; }
  tree=$("$B" snapshot tree "$snapshot_id" --json 2>&1) || { echo "tools/boat/golden: boat snapshot tree failed: ${tree:0:500}" >&2; exit 1; }
  warm=$(printf '%s' "$tree" | python3 -I -c '
import json, sys
mark = ".boat-keep/warm-at/"
found = [e["path"][len(mark):] for e in json.load(sys.stdin).get("entries", [])
         if e.get("path", "").startswith(mark) and e.get("kind") == "file"]
print(found[0] if len(found) == 1 else "")
')
  if [ "$warm" = "$master" ]; then
    echo "tools/boat/golden: $SNAPSHOT is at master ${master:0:9}; nothing to do" >&2
    exit 0
  fi
  held=${warm:0:9}
  echo "tools/boat/golden: $SNAPSHOT is at ${held:-an unknown commit}, master at ${master:0:9}: refreshing" >&2
fi

id=$("$B" new ${from[@]+"${from[@]}"} --type "$TYPE" --no-env --ttl 7200 --name "$SNAPSHOT-builder" --json | first_id)
trap '"$B" delete "$id" --yes >/dev/null 2>&1 || echo "tools/boat/golden: could not delete $id; run: boat delete $id --yes" >&2' EXIT
echo "tools/boat/golden: builder $id (${from[*]:-from nothing})" >&2
bx "$id" 'mkdir -p ~/.boat-keep'
for f in "$HERE"/sandbox/*; do
  [ -f "$f" ] || continue
  "$B" scp "$f" "$id:/home/user/.boat-keep/$(basename "$f")" >/dev/null
done
bx "$id" 'chmod +x ~/.boat-keep/*.sh ~/.boat-keep/*.py'
# The builder starts from the last snapshot, whose ~/golden.status is the
# last refresh's. Clear it before the build starts, and take only a status
# naming this run: a poll that comes before the detached build begins must
# not read the old one as this build's.
run="$(date +%s).$$.$RANDOM"
bx "$id" 'rm -f ~/golden.status ~/golden.log'
"$B" exec "$id" --detach -- bash -lc "~/.boat-keep/build-golden.sh > ~/golden.log 2>&1; echo \"$run \$?\" > ~/golden.status" >/dev/null
started=$(date +%s)
until status=$(bx "$id" 'cat ~/golden.status 2>/dev/null') && [ "${status%% *}" = "$run" ]; do
  [ $(( $(date +%s) - started )) -lt 5400 ] || { echo "tools/boat/golden: still building after 90 min; giving up" >&2; exit 1; }
  sleep "${FRAGMENT_BOAT_POLL:-20}"
done
status=${status#* }
bx "$id" 'grep "^== \|^fragment-times\|^times" ~/golden.log' || true  # a summary; none is no failure
if [ "$status" != 0 ]; then
  echo "tools/boat/golden: build-golden.sh failed ($status); $SNAPSHOT unchanged. The end of its log:" >&2
  bx "$id" 'tail -n 40 ~/golden.log' >&2
  exit 1
fi
"$B" snapshot "$id" "$SNAPSHOT" >/dev/null
echo "tools/boat/golden: $SNAPSHOT saved after $(( $(date +%s) - started ))s" >&2
