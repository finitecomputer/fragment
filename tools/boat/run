#!/usr/bin/env bash
# tools/boat/run: run a command from this checkout on a Boat sandbox
# (boat.dev) started from the warm snapshot, instead of on this computer.
# Optional; see "Building on Boat" in AGENTS.md.
#
#   tools/boat/run [--keep] [--] COMMAND...   e.g. tools/boat/run cargo xtask check
#   tools/boat/run --id | --stop | --delete   this checkout's kept sandbox
#
# One argument is a shell command line ('cargo xtask check && cargo test');
# several are one command and its arguments. The command runs in
# ~/Projects/fragment on the sandbox, with this checkout as it stands there:
# HEAD (sent as a git bundle when origin/master lacks it) and every
# uncommitted, untracked or deleted file. Ignored files stay here. Only
# files whose contents differ are written, so cargo rebuilds only what
# changed since the snapshot.
#
# Without --keep the sandbox is deleted when the command ends. With --keep
# this checkout keeps one sandbox: later --keep runs reuse it (resuming it
# if it stopped), it stops by itself FRAGMENT_BOAT_TTL seconds (default
# 3600) after the last run, and --stop or --delete ends it sooner. One run
# at a time per checkout. --id prints its id, for `boat scp ID:PATH .`
# (failed e2e logs are in ~/Projects/fragment/target/e2e).
#
# First: install the boat CLI, `boat login`, and make the snapshot with
# tools/boat/golden. Each run waits 1 to 2 minutes for the sandbox's disk
# before the command starts; that wait is in start.sh, and why.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/lib.sh"
TTL=${FRAGMENT_BOAT_TTL:-3600}

usage() { sed -n '6,7p' "$0" | sed 's/^# //' >&2; exit 2; }
mode=once
case "${1:-}" in
  --keep) mode=keep; shift ;;
  --id | --stop | --delete) mode=${1#--}; shift; [ $# -eq 0 ] || usage ;;
  -h | --help | "") usage ;;
esac
[ "${1:-}" != -- ] || shift
case $mode in once | keep) [ $# -gt 0 ] || usage ;; esac

ROOT=$(git rev-parse --show-toplevel)
[ -f "$ROOT/tools/boat/sandbox/start.sh" ] || { echo "tools/boat/run: $ROOT is not a fragment checkout" >&2; exit 1; }
STATE="$(git -C "$ROOT" rev-parse --absolute-git-dir)/boat-sandbox"
kept=$(cat "$STATE" 2>/dev/null || true)

case $mode in
  id) [ -n "$kept" ] || { echo "tools/boat/run: this checkout has no kept sandbox" >&2; exit 1; }; echo "$kept"; exit 0 ;;
  stop | delete)
    [ -n "$kept" ] || { echo "tools/boat/run: this checkout has no kept sandbox" >&2; exit 0; }
    if [ "$mode" = stop ]; then
      case $(state_of "$kept") in stopped | gone) ;; *) "$B" stop "$kept" >/dev/null ;; esac
      echo "tools/boat/run: $kept stopped; the next --keep run resumes it" >&2
    else
      [ "$(state_of "$kept")" = gone ] || "$B" delete "$kept" --yes >/dev/null
      rm -f "$STATE"
      echo "tools/boat/run: $kept deleted" >&2
    fi
    exit 0 ;;
esac

if [ $# -eq 1 ]; then command_line=$1; else command_line=$(printf '%q ' "$@"); fi
name="fragment-$(basename "$ROOT")"
name=${name:0:120}
new_sandbox() {
  "$B" new --from "$SNAPSHOT" --type "$TYPE" --no-env --ttl "$TTL" --name "$name" --json | first_id
}

work=$(mktemp -d)
id=""
finish() {
  rc=$?
  rm -rf "$work"
  if [ "$mode" = once ] && [ -n "$id" ]; then
    "$B" delete "$id" --yes >/dev/null 2>&1 || echo "tools/boat/run: could not delete $id; run: boat delete $id --yes" >&2
  fi
  exit $rc
}
trap finish EXIT
trap 'exit 130' INT TERM

if [ "$mode" = keep ] && [ -n "$kept" ]; then
  for _ in $(seq 1 60); do
    case $(state_of "$kept") in
      stopped) "$B" resume "$kept" --ttl "$TTL" >/dev/null; id=$kept; break ;;
      gone) break ;;
      creating | starting | resuming | stopping | pending) sleep 5 ;;
      *) "$B" extend "$kept" --ttl "$TTL" >/dev/null; id=$kept; break ;;  # running or idle
    esac
  done
fi
if [ -z "$id" ]; then
  id=$(new_sandbox)
  [ "$mode" = once ] || echo "$id" > "$STATE"
fi
echo "tools/boat/run: $id ($TYPE, from $SNAPSHOT)" >&2

started=$(date +%s)
bx "$id" 'rm -rf ~/fragment-src ~/fragment-head.bundle'
"$B" push "$id" "$ROOT" --to /home/user/fragment-src >/dev/null
sha=$(git -C "$ROOT" rev-parse HEAD)
if [ -n "$(git -C "$ROOT" rev-list -n 1 HEAD --not origin/master)" ]; then
  git -C "$ROOT" bundle create -q "$work/head.bundle" HEAD --not origin/master
  "$B" scp "$work/head.bundle" "$id:/home/user/fragment-head.bundle" >/dev/null
fi

save_times=""
[ "$mode" = once ] || save_times='python3 ~/fragment-src/tools/boat/sandbox/times.py save >/dev/null'
set +e
bx "$id" "bash ~/fragment-src/tools/boat/sandbox/start.sh ~/fragment-src $sha || exit 97
cd ~/Projects/fragment
$command_line
rc=\$?
$save_times
exit \$rc" 0
rc=$?
set -e
echo "tools/boat/run: exit $rc after $(( $(date +%s) - started ))s on $id" >&2
exit $rc
