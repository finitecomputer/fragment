#!/usr/bin/env bash
# tools/boat/run: run a command from this checkout on a Boat sandbox
# (boat.dev) instead of on this computer. Optional; AGENTS.md, "Building on
# Boat".
#
#   tools/boat/run COMMAND...   e.g. tools/boat/run cargo xtask check
#   tools/boat/run --refresh    make the warm snapshot, or bring it to master
#
# A checkout has one sandbox, started from the snapshot at its first run and
# stopped by Boat 15 minutes after its last; the next run resumes it. Each
# run sends the checkout as it stands (HEAD and every changed, new and
# deleted file that git does not ignore) as one git commit; inside.sh checks
# it out there and runs the command in it. The run's first line names the
# sandbox, for `boat scp` of what it left (~/Projects/fragment).
#
# Needs the boat CLI (`boat login`) and jq. Shell, not xtask: it runs where
# nothing is built, which is its point.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
B=$(command -v boat || echo "$HOME/.ascii/bin/boat")
SNAPSHOT=fragment-warm
# Seconds until Boat stops a sandbox: room for a run, then little to idle on.
RUNNING=7200 IDLE=900
die() { echo "tools/boat/run: $*" >&2; exit 1; }
command -v jq >/dev/null || die "jq is not installed"
[ -x "$B" ] || die "no boat CLI (https://boat.dev/install)"

# new [boat new's options]: a sandbox, its id printed.
new() {
  local out
  out=$("$B" new "$@" --type large --no-env --ttl "$RUNNING" --json) || die "boat new: $out"
  jq -rs '[.[] | (.id?, .sandbox.id?) | strings | select(startswith("bx_"))] | first // empty' <<< "$out"
}

# on ID COMMIT COMMAND: inside.sh there with those two, its output as it
# comes and its exit code. boat answers in JSON frames, one a line.
on() {
  "$B" exec "$1" --timeout 0 --stream -- bash -lc "set -- $(printf '%q ' "$2" "$3")
$(cat "$here/inside.sh")" | jq -Rrj --unbuffered '(fromjson? // {type: "stdout", data: (. + "\n")}) | objects | if .type == "stdout" or .type == "stderr" then .data elif .error then "boat: \(.error)\n" else empty end'
  return "${PIPESTATUS[0]}"
}

case ${1:-} in
  --refresh)
    # from the snapshot when there is one, else from nothing
    saved=$("$B" snapshots --json) || die "boat snapshots: $saved"
    from=$(jq -r --arg n "$SNAPSHOT" '.named[]? | select(.name == $n) | "--from " + .name' <<< "$saved")
    # shellcheck disable=SC2086 # two words, or none
    id=$(new $from --name "$SNAPSHOT-builder")
    [ -n "$id" ] || die "boat new named no sandbox"
    trap '"$B" delete "$id" --yes >/dev/null' EXIT
    echo "tools/boat/run: building on $id (${from:-from nothing})" >&2
    on "$id" master "" || die "the build failed: $SNAPSHOT is as it was"
    "$B" snapshot "$id" "$SNAPSHOT" >/dev/null
    echo "tools/boat/run: $SNAPSHOT saved" >&2
    exit 0 ;;
  "" | -h | --help) sed -n '6,7p' "$0" | cut -c3- >&2; exit 2 ;;
esac

cd "$(git rev-parse --show-toplevel)"
[ -f tools/boat/inside.sh ] || die "$PWD is not a fragment checkout"
state=$(git rev-parse --absolute-git-dir)/boat-sandbox
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# The checkout as it stands, as one commit: HEAD itself when nothing is
# changed, else a commit on it that this worktree's own ref keeps.
cp "$(git rev-parse --git-path index)" "$tmp/index"
GIT_INDEX_FILE=$tmp/index git add -A
tree=$(GIT_INDEX_FILE=$tmp/index git write-tree)
commit=$(git rev-parse HEAD)
[ "$tree" = "$(git rev-parse "HEAD^{tree}")" ] || commit=$(git -c user.name=boat -c user.email=boat@localhost commit-tree "$tree" -p HEAD -m "the checkout as it stands")
git update-ref refs/worktree/boat "$commit"

id=$(cat "$state" 2>/dev/null || true)
for _ in $(seq 30); do # a sandbox between two states (stopping, resuming) is asked again
  case $([ -z "$id" ] || "$B" info "$id" --json 2>/dev/null | jq -r '.sandbox | select(.dataExpiredAt | not) | .state') in
    ready | idle | running) "$B" extend "$id" --ttl "$RUNNING" >/dev/null; break ;;
    stopped) "$B" resume "$id" --ttl "$RUNNING" >/dev/null; break ;;
    *ing) sleep 2 ;;
    *) id=; break ;;
  esac
done
if [ -z "$id" ]; then
  id=$(new --from "$SNAPSHOT" --name "fragment-$(basename "$PWD")")
  [ -n "$id" ] || die "boat new named no sandbox"
  echo "$id" > "$state"
fi
echo "tools/boat/run: $id" >&2

# What master lacks of it goes as a bundle; the sandbox fetches master itself.
if ! git merge-base --is-ancestor "$commit" origin/master; then
  git bundle create -q "$tmp/bundle" refs/worktree/boat --not origin/master
  "$B" scp "$tmp/bundle" "$id:/home/user/checkout-$commit.bundle" >/dev/null
fi
if [ $# -eq 1 ]; then command=$1; else command=$(printf '%q ' "$@"); fi
rc=0
on "$id" "$commit" "$command" || rc=$?
"$B" extend "$id" --ttl "$IDLE" >/dev/null || true
exit "$rc"
