From c49ecd58922bdce210f68e96dfbd07d11d1c6bd5 Mon Sep 17 00:00:00 2001
From: Victor Kyriazakos <victor@rocketfueldev.com>
Date: Wed, 28 Oct 2026 23:49:04 +0000
Subject: [PATCH 2/2] fix(gateway): a cancel during the producer start hook
 releases its typing and bracket

A drain cancelled while on_processing_start is awaited left the typing refresh running and the
row's bracket in producer_turns, because producer_turn's finally was not entered yet. Release both
before re-raising.
---
 gateway/session_producer_lifecycle.py | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/gateway/session_producer_lifecycle.py b/gateway/session_producer_lifecycle.py
index 62e0404865..308ae321e5 100644
--- a/gateway/session_producer_lifecycle.py
+++ b/gateway/session_producer_lifecycle.py
@@ -78,7 +78,15 @@ async def _open(authority, row, event):
         # None for a heartbeat or ``typing_indicator: false``, as on the adapter path.
         bracket.typing = adapter._start_typing_refresh(event, bracket.stop, bracket.metadata)
     if hooks:
-        await adapter._run_processing_hook('on_processing_start', event)
+        try:
+            await adapter._run_processing_hook('on_processing_start', event)
+        except BaseException:
+            # Cancelled before ``producer_turn``'s finally exists: release what was opened here.
+            bracket.stop.set()
+            if bracket.typing is not None:
+                bracket.typing.cancel()
+            turns.pop(row['admission_id'], None)
+            raise
     return bracket
 
 
-- 
